menu "WO30109 新風控制器"
    config FA_MAX_RELAYS_ON
        int "同時吸合的繼電器上限"
        range 1 4
        default 3
        help
            12V 電源 IRM-02-12 額定 167mA、110%（184mA）進保護。G5Q 線圈每顆 33mA；Zigbee 收訊在 12V 側約 26mA，
            +10dBm 發射峰值再多約 32mA。3 顆：峰值約 158mA（在額定內）。4 顆：持續 159mA、發射峰值約 191mA
            （超過保護點，只有封包期間的毫秒級），設成 4 前要實測。三個風速模式本來最多只會同時吸 3 顆。
    config FA_ZB_TX_POWER
        int "802.15.4 發射功率 (dBm)"
        range -15 20
        default 10
        help
            +10dBm 峰值約 165mA@3.3V（12V 側 +30mA，毫秒級）。+20dBm 峰值 302mA 會讓 12V 電源瞬間超過 110% 保護點。
    config FA_INTERLOCK_DEAD_MS
        int "風速切換：斷開到吸合的間隔 (ms)"
        default 200
    config FA_RELAY_STAGGER_MS
        int "兩顆繼電器吸合的最小間隔 (ms)"
        default 50
endmenu
