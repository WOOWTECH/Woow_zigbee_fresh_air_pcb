menu "WO30109 新風控制器"
    choice FA_BOARD
        prompt "板子版本"
        default FA_BOARD_V33
        help
            V3.3 起 DI 腳位改了（與 NFC I2C 一起重排），並多了 NFC（U6 ST25DV04KC）。
        config FA_BOARD_V33
            bool "V3.3（DI＋NFC）"
        config FA_BOARD_V32
            bool "V3.2（DI，沒有 NFC）"
    endchoice

    config FA_RELAY_PWM_HOLD
        bool "繼電器 PWM 降壓保持（吸合後改 PWM，省 12V 電流）"
        default y
        help
            每顆線圈先全壓 FA_RELAY_PULLIN_MS，之後用 LEDC 以 FA_RELAY_PWM_HZ、FA_RELAY_HOLD_PCT duty 保持。
            60% duty、B5819W 續流時線圈平均 7.08V（額定 59%，Omron G5Q-1 要求 ≥30%），12V 端每顆 11.8mA（全壓 33.3mA）。
            關掉就回到 V3.0 的 GPIO 全壓驅動，FA_MAX_RELAYS_ON 預設回 3。

    config FA_RELAY_PULLIN_MS
        int "全壓吸合時間 (ms)"
        depends on FA_RELAY_PWM_HOLD
        range 100 1000
        default 100
        help
            Omron G5Q-1 規格書 p.6：降壓保持前要先加額定電壓至少 100ms。

    config FA_RELAY_HOLD_PCT
        int "保持 duty (%)"
        depends on FA_RELAY_PWM_HOLD
        range 50 100
        default 60
        help
            Omron 驗證 PWM 保持（-PW 型）的條件是 duty ≥50%、≥10kHz、續流二極體 Vf ≤0.4V。
            標準版 G5Q-1 沒有 PWM 背書，只規定保持電壓 ≥30%；取 60% 留給溫升（線圈電阻 +0.4%/°C）與振動。

    config FA_RELAY_PWM_HZ
        int "PWM 頻率 (Hz)"
        depends on FA_RELAY_PWM_HOLD
        range 10000 40000
        default 20000

    config FA_MAX_RELAYS_ON
        int "同時吸合的繼電器上限"
        range 1 4
        default 4 if FA_RELAY_PWM_HOLD
        default 3
        help
            12V 電源 IRM-02-12 額定 167mA、110%（184mA）進保護。12V 側常態約 26mA，+10dBm 發射峰值再多 32mA。
            PWM 保持（預設）：3 顆保持＋1 顆吸合＋發射 ≈ 127mA，可以 4 顆全開（吸合錯開 ≥ FA_RELAY_PULLIN_MS）。
            全壓驅動：4 顆＋發射峰值約 191mA，超過保護點，所以上限 3。

    config FA_TX_POWER
        int "802.15.4（Thread）發射功率 (dBm)"
        range -15 20
        default 10
        help
            ESP-IDF 的 802.15.4 驅動預設開到最大（ESP32-C6 為 +20dBm），峰值約 302mA@3.3V，會讓 12V 電源
            （IRM-02-12）瞬間超過 110% 保護點；+10dBm 峰值約 165mA@3.3V（12V 側 +30mA，毫秒級），電源預算以此計算。
            Thread 啟動後由 fa_matter.cpp 設定。
    config FA_INTERLOCK_DEAD_MS
        int "風速切換：斷開到吸合的間隔 (ms)"
        default 200
    config FA_RELAY_STAGGER_MS
        int "兩顆繼電器吸合的最小間隔 (ms)"
        default 110 if FA_RELAY_PWM_HOLD
        default 50
        help
            PWM 保持時要大於 FA_RELAY_PULLIN_MS，確保同一時間最多 1 顆在全壓吸合（電源預算的前提）。
    choice FA_PRESET
        prompt "出廠預設 DO 模式（V3.2 拿掉指撥，改軟體設定）"
        default FA_PRESET_FAN3
        help
            設成「互鎖」的幾路自動成一組（風速）。之後可在 Home Assistant／維護網頁改（V4 Matter），存在 NVS。
        config FA_PRESET_FAN3
            bool "三段風速＋1 路：K1–K3 互鎖、K4 自鎖"
        config FA_PRESET_FAN2
            bool "兩段風速＋2 路：K1–K2 互鎖、K3/K4 自鎖"
        config FA_PRESET_4CH
            bool "4 路獨立：全部自鎖"
        config FA_PRESET_SEL4
            bool "4 路互斥：全部互鎖"
    endchoice

    choice FA_DI_DEFAULT
        prompt "出廠預設 DI 模式（4 路相同；遙控器 4 鍵同步）"
        default FA_DI_DEFAULT_HOLD
        config FA_DI_DEFAULT_HOLD
            bool "持續：接通期間作動，斷開停止"
        config FA_DI_DEFAULT_PRESS
            bool "按一次：接通那一刻觸發一次"
        config FA_DI_DEFAULT_OFF
            bool "全關：不控制繼電器"
    endchoice

    config FA_JOG_MS
        int "出廠預設點動時間 (ms)"
        range 500 3600000
        default 1000
endmenu
