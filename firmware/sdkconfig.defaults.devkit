# 開發板上測 Thread 正式版（ESP32-C6-DevKitC-1 這類有板載 WS2812 的板子）：
# idf.py -B build_thread_devkit -D SDKCONFIG=sdkconfig.thread_devkit -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.devkit" build
CONFIG_FA_DEVKIT_RGB=y
# 多一個 endpoint（EP21 開發板彩色燈）：EP0＋20＋1＝22
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=22
