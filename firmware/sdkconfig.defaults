# WO_30109 V4（Matter over Thread，正式版）。Wi-Fi 測試版：idf.py -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.wifi_test"
CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# 藍牙只用來配對（BLE commissioning），配對完成後釋放記憶體
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_EXT_ADV=n
CONFIG_BT_NIMBLE_HCI_EVT_BUF_SIZE=70
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING=y

# Thread：市電供電 → FTD（可當路由器）
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_FTD=y
CONFIG_OPENTHREAD_SRP_CLIENT=y
CONFIG_OPENTHREAD_DNS_CLIENT=y
CONFIG_OPENTHREAD_LOG_LEVEL_DYNAMIC=n
CONFIG_OPENTHREAD_LOG_LEVEL_NOTE=y
CONFIG_OPENTHREAD_CLI=n
CONFIG_ENABLE_WIFI_STATION=n

# Matter 必要（官方範例 base defaults）：PASE／CASE 用 HKDF；IPv6 預設路由 hook；不用 SoftAP
CONFIG_MBEDTLS_HKDF_C=y
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=y
CONFIG_LWIP_IPV6_AUTOCONFIG=n
CONFIG_LWIP_IPV6_NUM_ADDRESSES=8
CONFIG_LWIP_MULTICAST_PING=y
CONFIG_USE_MINIMAL_MDNS=n
CONFIG_ENABLE_EXTENDED_DISCOVERY=y
CONFIG_ENABLE_CHIP_SHELL=y
CONFIG_SUPPORT_GROUPCAST_CLUSTER=n
# Fixed Label 用韌體內建的 DeviceInfoProvider（fa_matter.cpp FaDeviceInfo）
CONFIG_CUSTOM_DEVICE_INFO_PROVIDER=y
# Matter 工廠資料放 partitions.csv 的 fctry 分區（預設是 "nvs"，量產燒 esp-matter-mfg-tool 的產物時才對得上）。
# 開發期 fctry 是空的，配對碼仍用 CONFIG_ENABLE_TEST_SETUP_PARAMS 的測試值。
CONFIG_CHIP_FACTORY_NAMESPACE_PARTITION_LABEL="fctry"
# OTA 之後的版本再開（docs/v4-matter-spec.md §9）
CONFIG_ENABLE_OTA_REQUESTOR=n
